---
import Layout from '../layouts/Layout.astro';
const features = [
  ['Git-connected deployments','Push to your production branch or open a pull request. Hostbox receives the webhook and creates an isolated deployment.','git push origin main'],
  ['Framework detection','Detect Next.js, Vite, Astro, Nuxt, SvelteKit, Hugo, Gatsby, and static projects with sensible defaults.','Detected: Next.js'],
  ['Automatic HTTPS','Route custom domains through Caddy with automatic certificate provisioning and renewal.','TLS · Active'],
  ['Preview environments','Give branches and pull requests stable URLs so every change can be tested before merge.','feat-login.hostbox.app'],
  ['Streaming build logs','Follow build output in real time from the dashboard, including clear failure states and timing.','Build ready in 42s'],
  ['Instant rollback','Promote a previous immutable artifact without rebuilding or waiting for a new commit.','Promoted d9f2a1'],
  ['Encrypted variables','Encrypt secrets at rest, scope them per project, and inject them only when a deployment runs.','DB_URL=••••••••'],
  ['Notifications','Send deployment events to Slack, Discord, custom webhooks, or the in-product activity stream.','deployment.ready'],
  ['System operations','Inspect CPU, memory, disk, build queues, users, settings, and platform activity from one place.','System · Healthy'],
];
---
<Layout title="Hostbox Features — Everything between push and production">
  <section class="site-container feature-hero"><span class="eyebrow">Platform</span><h1 class="display">Everything between<br/><span class="word-accent">push and production.</span></h1><p class="hero-copy" style="margin-left:0;text-align:left">A complete deployment workflow built from inspectable infrastructure primitives on your VM.</p></section>
  <section class="site-container feature-list">
    {features.map(([title,copy,detail],index)=>(
      <article class="feature-row"><span class="feature-index">{String(index+1).padStart(2,'0')}</span><div><h2>{title}</h2><p>{copy}</p></div><code>{detail}</code></article>
    ))}
  </section>
  <section class="site-container section"><div class="terminal"><div class="terminal-bar"><div class="terminal-dots"><i></i><i></i><i></i></div><span>build.log</span><span>live</span></div><div class="terminal-body"><div><span class="muted">09:41:12</span> Cloning VatsalP117/web-app</div><div><span class="muted">09:41:13</span> Detected package.json and Next.js</div><div><span class="muted">09:41:14</span> Installing dependencies</div><div><span class="muted">09:41:29</span> Running next build</div><div><span class="success">09:41:54 Build completed</span></div><div><span class="accent">09:41:55 Ready at app.example.com</span></div></div></div></section>
  <section class="cta"><h2 class="section-title" style="margin-inline:auto">Deploy without giving up control.</h2><p class="section-copy">Run the platform where your applications already belong.</p><div class="hero-actions"><a class="button button-primary" href="https://github.com/VatsalP117/hostbox/blob/main/docs/SELF-HOSTING.md">Get started</a><a class="button" href="/cli">Explore the CLI</a></div></section>
</Layout>
<style>
  .feature-hero{padding:180px 0 110px;border-inline:1px solid #1f1f1f;padding-inline:clamp(24px,6vw,72px);background:radial-gradient(circle at 80% 20%,rgba(82,168,255,.09),transparent 28%)}
  .feature-list{border-top:1px solid #222}.feature-row{display:grid;grid-template-columns:70px 1fr minmax(190px,.45fr);gap:24px;align-items:center;padding:36px 0;border-bottom:1px solid #222}.feature-index{color:#555;font:11px "JetBrains Mono",monospace}.feature-row h2{margin:0 0 8px;font-size:20px;font-weight:500;letter-spacing:-.02em}.feature-row p{max-width:650px;margin:0;color:#888;font-size:14px;line-height:1.6}.feature-row code{justify-self:end;padding:10px 12px;border:1px solid #272727;border-radius:6px;background:#080808;color:#999;font:11px "JetBrains Mono",monospace}
  @media(max-width:720px){.feature-row{grid-template-columns:40px 1fr}.feature-row code{grid-column:2;justify-self:start}.feature-hero{padding-top:140px}}
</style>
