---
import Layout from '../layouts/Layout.astro';
const commands = [
  ['hbx deploy --prod','Build the current directory and promote it to production.'],
  ['hbx status','Inspect the linked project and its current production deployment.'],
  ['hbx logs -f','Stream application and build output without leaving the terminal.'],
  ['hbx env pull','Sync project environment variables into a local file.'],
  ['hbx rollback','Promote a previous healthy deployment immediately.'],
];
---
<Layout title="Hostbox CLI — Your deployment workflow in the terminal">
  <section class="site-container cli-hero">
    <div><span class="eyebrow">Hostbox CLI</span><h1 class="display">The dashboard,<br/><span class="word-accent">at your fingertips.</span></h1><p class="hero-copy" style="margin-left:0;text-align:left">Deploy, inspect, and recover projects from a small CLI that talks directly to your Hostbox instance.</p><div class="hero-actions" style="justify-content:flex-start"><a class="button button-primary" href="https://github.com/VatsalP117/hostbox/tree/main/cmd/cli">View CLI source</a><a class="button" href="https://github.com/VatsalP117/hostbox#readme">Read the docs</a></div></div>
    <div class="terminal"><div class="terminal-bar"><div class="terminal-dots"><i></i><i></i><i></i></div><span>hostbox — zsh</span><span>⌘K</span></div><div class="terminal-body"><div><span class="muted">$</span> curl -fsSL hostbox.dev/cli | sh</div><div class="muted">Downloading hbx for darwin/arm64...</div><div class="success">Installed hbx to /usr/local/bin</div><br/><div><span class="muted">$</span> hbx deploy --prod</div><div>Building web-app...</div><div class="accent">Ready: https://app.example.com</div></div></div>
  </section>
  <section class="site-container command-section"><div class="section-heading"><h2 class="section-title">One API.<br/>Two interfaces.</h2><p class="section-copy">The dashboard and CLI share the same authentication and platform API. Switch between them without losing context.</p></div><div class="commands">{commands.map(([command,copy])=><article><code>$ {command}</code><p>{copy}</p><span>→</span></article>)}</div></section>
  <section class="site-container section site-rule"><div class="metric-row"><div class="metric"><strong>1</strong><span>Portable binary</span></div><div class="metric"><strong>5</strong><span>Core workflows</span></div><div class="metric"><strong>100%</strong><span>Same platform API</span></div><div class="metric"><strong>0</strong><span>Cloud accounts required</span></div></div></section>
  <section class="cta"><h2 class="section-title" style="margin-inline:auto">Ship from where you work.</h2><p class="section-copy">Link a project once, then deploy it in one command.</p><div class="hero-actions"><a class="button button-primary" href="https://github.com/VatsalP117/hostbox#readme">Install the CLI</a></div></section>
</Layout>
<style>
  .cli-hero{display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center;padding:180px 0 120px}.cli-hero .display{font-size:clamp(3rem,5.6vw,5.3rem)}.command-section{padding:100px 0}.commands{border-top:1px solid #222}.commands article{display:grid;grid-template-columns:minmax(220px,.7fr) 1fr 30px;gap:32px;align-items:center;padding:26px 8px;border-bottom:1px solid #222}.commands code{color:#ddd;font:13px "JetBrains Mono",monospace}.commands p{margin:0;color:#888;font-size:14px}.commands span{color:#555}
  @media(max-width:800px){.cli-hero{grid-template-columns:1fr;gap:48px;padding-top:140px}.commands article{grid-template-columns:1fr}.commands span{display:none}}
</style>
