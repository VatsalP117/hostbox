---
const year = new Date().getFullYear();
---
<footer>
  <div class="site-container footer-grid">
    <div class="footer-brand"><svg class="footer-mark" aria-hidden="true" viewBox="0 0 32 32" fill="none"><path d="M6.5 10.5 16 5l9.5 5.5v11L16 27l-9.5-5.5v-11Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="m6.5 10.5 9.5 5.5 9.5-5.5M16 16v11" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="m11 8 9.5 5.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity=".45"/></svg><strong>Hostbox</strong><p>Your code. Your server.<br/>One deployment workflow.</p></div>
    <div><h2>Product</h2><a href="/features">Features</a><a href="/cli">CLI</a><a href="https://github.com/VatsalP117/hostbox/blob/main/docs/SELF-HOSTING.md">Self-hosting</a></div>
    <div><h2>Resources</h2><a href="https://github.com/VatsalP117/hostbox#readme">Documentation</a><a href="https://github.com/VatsalP117/hostbox/issues">Support</a><a href="https://github.com/VatsalP117/hostbox/releases">Releases</a></div>
    <div><h2>Project</h2><a href="https://github.com/VatsalP117/hostbox">GitHub</a><a href="https://github.com/VatsalP117/hostbox/blob/main/LICENSE">MIT License</a><span>© {year} Hostbox</span></div>
  </div>
</footer>
<style>
  footer { border-top:1px solid #222; padding:72px 0; background:#050505; }
  .footer-grid { display:grid; grid-template-columns:2fr repeat(3,1fr); gap:48px; }
  .footer-brand strong { margin-left:10px; font-size:14px; }
  .footer-mark { display:inline-block; width:20px; height:20px; color:#52a8ff; vertical-align:middle; }
  p { color:#777; font-size:13px; line-height:1.7; }
  h2 { margin:0 0 18px; color:#ddd; font-size:12px; font-weight:500; }
  a, span { display:block; margin:0 0 12px; color:#777; font-size:12px; }
  a:hover { color:#fff; }
  @media(max-width:720px){ .footer-grid{grid-template-columns:1fr 1fr}.footer-brand{grid-column:span 2} }
</style>
